# Copy to .env to use Supabase locally. Copy the Transaction pooler URI from
# Supabase Dashboard > Connect and replace its password placeholder.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@YOUR_POOLER_HOST:6543/postgres

# Generate a long random value and keep the same value across deployments.
TRUSTPASS_SIGNING_KEY=replace-with-a-long-random-secret
